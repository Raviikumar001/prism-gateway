# Server
PORT=8080
ADMIN_TOKEN=dev-admin-change-me
LOG_LEVEL=info
DATA_DIR=data
UPSTREAM_TIMEOUT=120s

# Data stores (docker compose defaults)
DATABASE_URL=postgres://prism:prism@localhost:5432/prism?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Providers: mocks | live
# live defaults GATEWAY_CONFIG to data/gateway_config.live.json when unset
PROVIDER_MODE=mocks
# GATEWAY_CONFIG=data/gateway_config.sample.json
SEED_ON_BOOT=true

# Live only (required when PROVIDER_MODE=live)
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
