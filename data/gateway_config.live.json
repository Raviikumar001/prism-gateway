{
  "_comment": "Live providers: Cerebras active models + curated OpenRouter mix (cheap OSS + Google/OpenAI/Anthropic).",
  "providers": [
    {
      "name": "cerebras",
      "base_url": "https://api.cerebras.ai/v1",
      "api_key_env": "CEREBRAS_API_KEY",
      "models": ["gemma-4-31b", "gpt-oss-120b"]
    },
    {
      "name": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "models": [
        "mistralai/mistral-nemo",
        "google/gemma-3-4b-it",
        "google/gemma-3-12b-it",
        "google/gemma-4-31b-it",
        "openai/gpt-4.1-nano",
        "openai/gpt-4o-mini",
        "openai/gpt-4.1-mini",
        "openai/gpt-4o",
        "openai/gpt-oss-120b",
        "google/gemini-2.5-flash-lite",
        "google/gemini-2.5-flash",
        "google/gemini-2.5-pro",
        "anthropic/claude-3-haiku",
        "anthropic/claude-haiku-4.5",
        "anthropic/claude-sonnet-4",
        "meta-llama/llama-3.3-70b-instruct",
        "deepseek/deepseek-chat-v3-0324",
        "mistralai/mistral-small-3.1-24b-instruct"
      ],
      "extra_headers": {
        "HTTP-Referer": "https://github.com/Raviikumar001/prism-gateway",
        "X-OpenRouter-Title": "Prism Gateway"
      }
    }
  ],
  "model_aliases": {
    "fast": {
      "primary": "mistralai/mistral-nemo",
      "fallbacks": [
        "openai/gpt-4.1-nano",
        "gemma-4-31b"
      ]
    },
    "smart": {
      "primary": "gpt-oss-120b",
      "fallbacks": [
        "openai/gpt-oss-120b",
        "anthropic/claude-haiku-4.5"
      ]
    },
    "auto": {
      "route_by_difficulty": { "simple": "fast", "complex": "smart" }
    }
  },
  "retry": { "max_attempts": 4, "initial_backoff_ms": 200, "backoff_multiplier": 2 }
}
